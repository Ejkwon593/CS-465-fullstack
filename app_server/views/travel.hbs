{{> header}}

<h2>Travel Packages</h2>
<ul>
  {{#each trips}}
    <li style="margin-bottom: 30px; list-style: none;">
      <h3>{{title}}</h3>
      <p>{{description}}</p>
      <p><strong>Price:</strong> ${{price}}</p>
      <img src="/images/{{image}}" alt="{{title}}" 
           style="width:300px; height:auto; margin-top:10px; border-radius:10px;">
    </li>
  {{/each}}
</ul>

{{> footer}}
